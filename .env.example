# WHOOP Developer App credentials
# Create an app at https://developer.whoop.com
WHOOP_CLIENT_ID=your_client_id_here
WHOOP_CLIENT_SECRET=your_client_secret_here
# Optional HTTP loopback URL (localhost, 127.0.0.1, or [::1]) registered with WHOOP
WHOOP_REDIRECT_URI=http://localhost:3000/callback

# --- Hosted deployment (Vercel + Supabase) — see references/vercel-supabase.md ---
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_or_sb_secret_key   # server-side only!
# MCP_AUTH_TOKEN=generate_with_openssl_rand_hex_32
# MCP_JWT_SECRET=another_openssl_rand_hex_32
# WHOOP_TOKEN_ENCRYPTION_KEY=a_third_openssl_rand_hex_32
# MCP_CONNECTOR_PASSWORD=at_least_12_characters
# PUBLIC_URL=https://your-domain.vercel.app   # optional on Vercel
